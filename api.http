### Register a new user
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "name": "Rijan Khatri",
  "email": "rijan@test.com",
  "password": "rijan123",
  "phone": "9827782888",
  "role": "tenant"
}
### Login user
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "rijan@test.com",
  "password": "rijan123"
}
### Login with wrong password
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "rijan@test.com",
  "password": "wrongpass"
}
### Create a room (protected route)
POST http://localhost:5000/api/rooms
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhNTllZDU2OTg2NTRiODllZTk4ZjkxMiIsImlhdCI6MTc4NDI3OTE5OSwiZXhwIjoxNzg0ODgzOTk5fQ.vqF6TAtR3LqsibtyPSYq33pD0TwLGGEWqpZm6EOcWws

{
  "title": "Cozy Single Room in Baneshwor",
  "description": "Quiet room close to college, water and wifi included",
  "type": "single",
  "pricePerMonth": 8000,
  "location": {
    "city": "Kathmandu",
    "district": "Baneshwor",
    "address": "New Baneshwor, near ring road",
    "latitude": 27.6935,
    "longitude": 85.3435
  },
  "amenities": ["wifi", "water supply", "attached bathroom"],
  "isAvailable": true
}
### Try creating room without token (should fail)
POST http://localhost:5000/api/rooms
Content-Type: application/json

{
  "title": "This should fail",
  "type": "single",
  "pricePerMonth": 5000,
  "location": {
    "city": "Kathmandu",
    "address": "Somewhere"
  }
}
### Get all rooms
GET http://localhost:5000/api/rooms

### Get all rooms filtered by city
GET http://localhost:5000/api/rooms?city=Kathmandu

### Get one room by ID
GET http://localhost:5000/api/rooms/6a59f11c777f9b8d2a501829
### Create a booking
POST http://localhost:5000/api/bookings
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhNTllZDU2OTg2NTRiODllZTk4ZjkxMiIsImlhdCI6MTc4NDI3OTE5OSwiZXhwIjoxNzg0ODgzOTk5fQ.vqF6TAtR3LqsibtyPSYq33pD0TwLGGEWqpZm6EOcWws

{
  "roomId": "6a59f11c777f9b8d2a501829",
  "moveInDate": "2026-08-01",
  "moveOutDate": "2026-11-01"
}
